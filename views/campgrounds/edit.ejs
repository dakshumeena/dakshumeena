<% layout('layouts/boilerplate') %>
  <div class="row">
    <h1 class="text-center">Update Campground</h1>
    <div class="col-6 offset-3">
      <form action="/campgrounds/<%=campground._id%>?_method=PUT" novalidate class="needs-validation" method="post">
        <div class="mb-3">
          <label class="form-label" name="title">Title</label>
          <input class="form-control" type="text" id="title" name="campground[title]" value="<%=campground.title%>" required>
        </div>

        <div class="mb-3">
          <label class="form-label" name="location">Location</label>
          <input class="form-control" type="text" id="location" name="campground[location]" value="<%=campground.location%>"required>
        </div>
          <div class="mb-3">
          <label class="form-label" name="image">image</label>
          <input class="form-control" type="text" id="image" name="campground[image]" value="<%=campground.image%>" required>
        </div>
          <div class="mb-3">
          <label class="form-label" name="price">price</label>
          <input class="form-control" type="number" id="price" name="campground[price]" value="<%=campground.price%>" required>
        </div>
            <div class="mb-3">
          <label class="form-label" name="description">description</label>
           <textarea class="form-control " id="description" placeholder="description" name="campground[description]" ><%=campground.description  %> required</textarea>
        </div>
        <div class="mb-3">
          <button class="btn btn-success">update campground</button>
        </div>
        
      </form>
      <a href="/campgrounds/<%=campground._id%>">back to campground</a>
    </div>


  </div>
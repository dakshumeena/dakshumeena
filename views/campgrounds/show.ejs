<% layout('layouts/boilerplate') %>
<link rel="stylesheet" href="/stylesheets/stars.css">

<div class="container gap-4 d-flex justify-content-center">

  <div class="card mb-3" style="max-width: 650px;height: 100%;">

    <!-- Carousel -->
    <div id="carouselExampleControls" class="carousel slide" data-bs-ride="carousel">
      <div class="carousel-inner">

        <% if (campground.images && campground.images.length) { %>

          <% for (let i = 0; i < campground.images.length; i++) { 
               let img = campground.images[i];
               if (!img.url) continue; %>

            <div class="carousel-item <%= i === 0 ? 'active' : '' %>">
              <img class="d-block w-100 card-img-top"
                   src="<%= img.url.replace('/upload/', '/upload/w_400,q_auto,f_auto/') %>">
            </div>

          <% } %>

        <% } else { %>

          <!-- fallback image -->
          <div class="carousel-item active">
            <img class="d-block w-100"
                 src="https://via.placeholder.com/600x400?text=No+Image">
          </div>

        <% } %>

      </div>

      <!-- Controls -->
      <button class="carousel-control-prev" type="button"
              data-bs-target="#carouselExampleControls" data-bs-slide="prev">
        <span class="carousel-control-prev-icon"></span>
      </button>

      <button class="carousel-control-next" type="button"
              data-bs-target="#carouselExampleControls" data-bs-slide="next">
        <span class="carousel-control-next-icon"></span>
      </button>

    </div>

    <!-- Card Body -->
    <div class="card-body">
      <h5 class="card-title"><%= campground.title %></h5>
      <p class="card-text"><%= campground.description %></p>
    </div>

    <ul class="list-group list-group-flush">
      <li class="list-group-item">
        <b>Location:</b> <%= campground.location %>
      </li>

      <li class="list-group-item">
        <b>Submitted by:</b> <%= campground.author.username %>
      </li>

      <li class="list-group-item">
        <b>Price:</b> $<%= campground.price %>
      </li>
    </ul>

    <% if (currentUser && campground.author.equals(currentUser._id)) { %>
      <div class="card-body d-flex justify-content-center gap-3">
        <a href="/campgrounds/<%= campground._id %>/edit"
           class="btn btn-warning">Edit</a>

        <form action="/campgrounds/<%= campground._id %>?_method=DELETE"
              method="POST">
          <button class="btn btn-danger">Delete</button>
        </form>
      </div>
    <% } %>

    <div class="card-footer text-body-secondary">
      2 days ago
    </div>

  </div>

  <!-- Reviews Section -->
  <div class="col-6">

    <% if (currentUser) { %>
      <h2>Add a review</h2>

      <form action="/campgrounds/<%= campground._id %>/reviews"
            method="post" novalidate class="needs-validation">

        <fieldset class="starability-basic mb-3">
          <input type="radio" name="review[rating]" value="1">
          <input type="radio" name="review[rating]" value="2">
          <input type="radio" name="review[rating]" value="3">
          <input type="radio" name="review[rating]" value="4">
          <input type="radio" name="review[rating]" value="5">
        </fieldset>

        <div class="mb-3">
          <label class="form-label">Review:</label>
          <textarea class="form-control"
                    name="review[body]"
                    required></textarea>
        </div>

        <button class="btn btn-success mb-3">Submit</button>
      </form>
    <% } %>

    <!-- Reviews list -->
    <% for (let review of campground.reviews) { %>
      <div class="card mb-3">
        <div class="card-body">

          <b><%= review.author.username %></b>

          <p class="starability-result"
             data-rating="<%= review.rating %>">
            Rated: <%= review.rating %> stars
          </p>

          <p><%= review.body %></p>

          <% if (currentUser &&
                 review.author._id.equals(currentUser._id)) { %>

            <form action="/campgrounds/<%= campground._id %>/reviews/<%= review._id %>?_method=DELETE"
                  method="POST">
              <button class="btn btn-danger">Remove</button>
            </form>

          <% } %>

        </div>
      </div>
    <% } %>

  </div>

</div>

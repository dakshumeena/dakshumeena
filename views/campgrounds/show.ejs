<% layout('layouts/boilerplate') %>

<div class="container gap-4 d-flex justify-content-center">

  <div class="card mb-3" style="max-width:650px;height:100%;">

    <!-- Carousel -->
    <div id="carouselExampleControls" class="carousel slide">
      <div class="carousel-inner">

        <% if (campground.images?.length) { %>
          <% campground.images.forEach((img,i)=>{ if(!img.url) return; %>
            <div class="carousel-item <%= i===0?'active':'' %>">
              <img class="d-block w-100"
                   src="<%= img.url.replace('/upload/','/upload/w_400,q_auto,f_auto/') %>">
            </div>
          <% }) %>
        <% } else { %>
          <div class="carousel-item active">
            <img class="d-block w-100"
                 src="https://via.placeholder.com/600x400?text=No+Image">
          </div>
        <% } %>

      </div>

      <button class="carousel-control-prev"
              data-bs-target="#carouselExampleControls"
              data-bs-slide="prev">
        <span class="carousel-control-prev-icon"></span>
      </button>

      <button class="carousel-control-next"
              data-bs-target="#carouselExampleControls"
              data-bs-slide="next">
        <span class="carousel-control-next-icon"></span>
      </button>
    </div>

    <div class="card-body">
      <h5><%= campground.title %></h5>
      <p><%= campground.description %></p>
    </div>

    <ul class="list-group">
      <li class="list-group-item"><b>Location:</b> <%= campground.location %></li>
      <li class="list-group-item"><b>By:</b> <%= campground.author.username %></li>
      <li class="list-group-item"><b>Price:</b> $<%= campground.price %></li>
    </ul>

  </div>

  <!-- Reviews -->
  <div class="col-6">

    <% if(currentUser){ %>
      <h3>Add Review</h3>

      <form action="/campgrounds/<%= campground._id %>/reviews" method="POST">

        <fieldset class="starability-basic mb-3">
          <input type="radio" name="review[rating]" value="5"><label>5</label>
          <input type="radio" name="review[rating]" value="4"><label>4</label>
          <input type="radio" name="review[rating]" value="3"><label>3</label>
          <input type="radio" name="review[rating]" value="2"><label>2</label>
          <input type="radio" name="review[rating]" value="1"><label>1</label>
        </fieldset>

        <textarea name="review[body]" class="form-control mb-2" required></textarea>

        <button class="btn btn-success">Submit</button>
      </form>
    <% } %>

    <% campground.reviews.forEach(review=>{ %>
      <div class="card mt-3">
        <div class="card-body">

          <b><%= review.author.username %></b>

          <!-- ⭐ STAR DISPLAY -->
          <p class="starability-result"
             data-rating="<%= review.rating %>"></p>

          <p><%= review.body %></p>

        </div>
      </div>
    <% }) %>

  </div>

</div>

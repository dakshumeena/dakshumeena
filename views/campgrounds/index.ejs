<% layout('layouts/boilerplate') %>
<div id="cluster-map"></div>

<h1 class="d-flex justify-content-center">All Campgrounds</h1>

<% for (let camp of campgrounds) { %>

  <div class="card mb-3">
    <div class="row">

      <div class="col-md-4">

        <% if (camp.images && camp.images.length && camp.images[0].url) { %>

          <img class="img-fluid"
               src="<%= camp.images[0].url.replace('/upload/', '/upload/w_400,q_auto,f_auto/') %>">

        <% } else { %>

          <!-- fallback image -->
          <img class="img-fluid"
               src="https://via.placeholder.com/400x300?text=No+Image">

        <% } %>

      </div>

      <div class="col-md-8">
        <div class="card-body">

          <h5 class="card-title"><%= camp.title %></h5>

          <p class="card-text"><%= camp.description %></p>

          <a class="btn btn-warning"
             href="/campgrounds/<%= camp._id %>">
             View campground
          </a>

        </div>
      </div>

    </div>
  </div>

<% } %>
<%- "<script>" %>
const maptilerApiKey = "<%- process.env.MAPTILER_API_KEY %>";
const campgrounds = {
  type: "FeatureCollection",
  features: <%- JSON.stringify(
    campgrounds.map(campground => ({
      type: "Feature",
      geometry: campground.geometry,
      properties: { popUpMarkup: campground?.properties?.popUpMarkup }
    }))
  ) %>
};
<%- "</script>" %>

<script src="/javascripts/clusterMap.js"></script>